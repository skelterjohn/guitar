
mezzanine_one_a={
  \set Staff.connectArpeggios = ##t
  \time 3/4
  \key d \major
  \tempo 4=72
  <<
    \new Voice { \voiceOne
      \set fingeringOrientations = #'(left)
      \set stringNumberOrientations = #'(up)
      
      \mark \markup { \circle "A" }
      
      R2. |
      \bar "||"
    }
  >>
}


